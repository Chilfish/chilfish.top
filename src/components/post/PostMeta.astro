---
import type { PostSchema } from '~/types'
import { Calendar, Pencil, Tag, User } from '@lucide/astro'
import { formatDate } from '~/utils'

type Props = PostSchema & {
  category: string
}

const {
  title,
  author,
  date: pubDate,
  modifiedDate,
  category,
} = Astro.props
---

<header class="mb-6 flex flex-col justify-center border-b border-gray p-4">
  <h1
    class="pb-6 text-center text-3xl font-bold leading-tight"
  >
    {title}
  </h1>

  <div
    class="metas flex flex-wrap items-center gap-4 text-3.5"
  >
    <div title="作者">
      <User class="icon" />
      <span> {author} </span>
    </div>

    <div title="写作日期">
      <Calendar class="icon" />
      <time> {formatDate(pubDate)} </time>
    </div>

    {modifiedDate && (
      <div title="最后修改日期">
        <Pencil class="icon" />
        <span>上次编辑于</span>
        <time> {formatDate(modifiedDate)} </time>
      </div>
    )}

    <div title="分类">
      <Tag class="icon" />
      <span> {category} </span>
    </div>
  </div>
</header>

<style>
.metas div {
  @apply: icon-box;
}
</style>
