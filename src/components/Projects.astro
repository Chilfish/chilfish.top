---
import { BannerProjects, githubHost, ProjectList } from '~/constant'
import LinkBar from './common/LinkBar.astro'
import ProjectCard from './project/ProjectCard.astro'
---

<div>
  <LinkBar
    title="Projects"
    href={githubHost}
  />

  <div
    uno-grid="~ cols-1 sm:cols-2"
    class="mt-3 gap-4 trans-all"
  >
    { BannerProjects.map(project => <ProjectCard project={project} />) }
  </div>

  <a
    href="/projects"
    class="mt-4 center gap-1 text-sm text-primary hover:underline"
  >
    <span>查看全部 {ProjectList.length} 个项目</span>
    <span class="i-tabler:arrow-right icon" />
  </a>
</div>
