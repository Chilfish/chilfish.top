---
import { siBilibili, siDiscord, siGithub, siGmail, siNeteasecloudmusic, siSinaweibo, siX, siXiaohongshu } from 'simple-icons'
import BrandIcon from './common/BrandIcon.astro'

const SocialList = [
  {
    name: 'github',
    link: 'https://github.com/Chilfish',
    icon: siGithub,
    color: '#010101',
  },
  {
    name: 'gmail',
    link: 'mailto:chill4fish@gmail.com',
    icon: siGmail,
    color: '#E84234',
  },
  {
    name: 'weibo',
    link: 'https://weibo.com/chilfish',
    icon: siSinaweibo,
    color: '#FF8200',
  },
  {
    name: 'bilibili',
    link: 'https://space.bilibili.com/259486090',
    icon: siBilibili,
    color: '#fb7299',
  },
  {
    name: 'xiaohongshu',
    link: 'https://www.xiaohongshu.com/user/profile/62f46c25000000001f0062fd',
    icon: siXiaohongshu,
    color: '#FF2442',
  },
  {
    name: 'twitter',
    link: 'https://twitter.com/chilfish_',
    icon: siX,
    color: '#00ACEE',
  },
  {
    name: 'discord',
    link: 'https://discord.com/users/1039168181215961199',
    icon: siDiscord,
    color: '#5865F2',
  },
  {
    name: '163 Music',
    link: 'https://music.163.com/user/home?id=1533509979',
    icon: siNeteasecloudmusic,
    color: '#DD001B',
  },
] as const
---

<div class="mt-4">
  <p>You can find me at</p>
  <ul>
    { SocialList.map(social => (
      <a
        style={{
          'background-color': social.color,
        }}
        href={social.link}
        title={social.name}
        target="_blank"
      >
        <BrandIcon icon={social.icon} class="icon" />
      </a>
    )) }
  </ul>
</div>

<style>
ul {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem;
  margin-top: 1rem;
}

a {
  @apply: rounded-full p-2 icon-box text-white;
}
</style>
