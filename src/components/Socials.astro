---
import { AtSign, GitFork, Mail, MessageCircle, Music, Tv } from '@lucide/astro'

const SocialList = [
  {
    name: 'github',
    link: 'https://github.com/Chilfish',
    icon: GitFork,
    color: '#010101',
  },
  {
    name: 'gmail',
    link: 'mailto:chill4fish@gmail.com',
    icon: Mail,
    color: '#E84234',
  },
  {
    name: 'weibo',
    link: 'https://weibo.com/chilfish',
    icon: MessageCircle,
    color: '#FF8200',
  },
  {
    name: 'bilibili',
    link: 'https://space.bilibili.com/259486090',
    icon: Tv,
    color: '#fb7299',
  },
  {
    name: 'twitter',
    link: 'https://twitter.com/chilfish_',
    icon: AtSign,
    color: '#00ACEE',
  },
  {
    name: '163 Music',
    link: 'https://music.163.com/user/home?id=1533509979',
    icon: Music,
    color: '#DD001B',
  },
] as const
---

<div class="mt-4">
  <p>You can find me at</p>
  <ul>
    { SocialList.map((social) => {
      const Icon = social.icon
      return (
        <a
          style={{
            'background-color': social.color,
          }}
          href={social.link}
          title={social.name}
          target="_blank"
        >
          <Icon class="icon" />
        </a>
      )
    }) }
  </ul>
</div>

<style>
ul {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0.5rem;
  margin-top: 1rem;
}

a {
  @apply: rounded-full p-2 icon-box text-white;
}
</style>
