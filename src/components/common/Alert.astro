---
import { BadgeAlert, Info, Lightbulb, OctagonAlert, TriangleAlert } from '@lucide/astro'

const TypeArr = [
  {
    type: 'note',
    icon: Info,
    color: '#2f81f7',
  },
  {
    type: 'warning',
    icon: TriangleAlert,
    color: '#d29922',
  },
  {
    type: 'caution',
    icon: OctagonAlert,
    color: '#f85149',
  },
  {
    type: 'tip',
    icon: Lightbulb,
    color: '#3fb950',
  },
  {
    type: 'important',
    icon: BadgeAlert,
    color: '#a371f7',
  },
] as const

type Props = {
  type: typeof TypeArr[number]['type']
  class?: string
  text?: string
}

const { type, text, class: className = '' } = Astro.props

const color = TypeArr.find(item => item.type === type)!.color
const Icon = TypeArr.find(item => item.type === type)!.icon
const title = type.charAt(0).toUpperCase() + type.slice(1)
---

<blockquote
  style={`
    border-left-color: ${color};
  `}
  class={`alert m-3 border-l-3 p-2 pl-4 ${className}`}
>
  <div
    style={`color: ${color}`}
    class="mb-2 flex items-center gap-2 font-bold"
  >
    <Icon class="icon" />
    <span>{title}</span>
  </div>
  { text
    ? <p>{text}</p>
    : <slot /> }
</blockquote>
