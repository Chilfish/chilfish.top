---
import type { MainProps } from '~/types'
import { SEO } from 'astro-seo'
import { ClientRouter } from 'astro:transitions'
import { host } from '~/constant'

type Props = MainProps

const {
  title: _title,
  author,
  description,
  cover,
  date,
  modifiedDate,
  tags,
  keywords: _keywords,
}
 = Astro.props.frontmatter || Astro.props

const desc = description || 'Chilfish\'s personal website, built with Astro & ❤️'
const image = cover || `${host}/avatar.webp`
const title = _title ? `${_title} | Chilfish` : 'Chilfish'
const keywords = _keywords ?? tags?.join(', ') ?? 'blog'

/** 无 date 的页面（列表 / 标签 / 归档等）不输出 article 元信息，避免 Invalid Date */
function toIsoDate(value?: Date | string) {
  if (!value)
    return undefined

  const parsed = new Date(value)
  return Number.isNaN(parsed.getTime()) ? undefined : parsed.toISOString()
}

const publishedTime = toIsoDate(date)
---

<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width"
  />
  <link
    rel="icon"
    type="image/x-icon"
    href="/favicon.ico"
  />
  <link
    rel="sitemap"
    href="/sitemap-index.xml"
  />
  <meta
    name="generator"
    content={Astro.generator}
  />
  <meta
    name="author"
    content={author}
  />
  <meta
    name="keywords"
    content={keywords}
  />
  <SEO
    title={title}
    description={desc}
    openGraph={{
      basic: {
        title,
        type: 'website',
        image,
      },
      image: {
        url: image,
        alt: title,
      },
      optional: {
        description: desc,
      },
      ...(publishedTime
        ? {
            article: {
              publishedTime,
              modifiedTime: toIsoDate(modifiedDate) ?? publishedTime,
              authors: [author ?? 'Chilfish'],
            },
          }
        : {}),
    }}
    twitter={{
      creator: '@chilfish_',
      title,
      description: desc,
      image,
      card: cover ? 'summary_large_image' : 'summary',
    }}
  />

  <script is:inline src="https://unpkg.com/nprogress@0.2.0/nprogress.js"></script>
  <ClientRouter />
  <title>{title}</title>
</head>
