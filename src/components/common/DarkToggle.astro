---
import { Moon, Sun } from '@lucide/astro'
---

<button
  class="dark-toggle hover:text-primary"
>
  <Moon class="icon dark:hidden" />
  <Sun class="icon hidden dark:block" />
</button>

<script>
function toggleDark() {
  const toggle = useToggle(isDark)
  const btn = document.querySelector('.dark-toggle')! as HTMLButtonElement

  btn.onclick = () => toggle()
}

document.addEventListener('astro:page-load', () => {
  toggleDark()
})
</script>
